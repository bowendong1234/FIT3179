{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 600,
    "height": 400,
    "title": {
        "text": "Sales of Inhalers for Shortness of Breath during Black Summer",
        "fontSize": 18
    },
    "data": {
        "url": "inhaler_pres_shortness_of_breath.csv",
        "format": {
            "type": "csv"
        }
    },
    "transform": [
        {
            "fold": [
                "Victoria",
                "New South Wales",
                "Queensland",
                "Australian Capital Territory",
                "Northern Territory",
                "South Australia",
                "Western Australia",
                "Tasmania"
            ],
            "as": [
                "State",
                "Value"
            ]
        }
    ],
    "layer": [
        {
            "mark": {
                "type": "rect",
                "color": "#f0e68c",
                "opacity": 0.01
            },
            "encoding": {
                "x": {
                    "datum": "1/12/2019"
                },
                "x2": {
                    "datum": "26/1/2020"
                }
            }
        },
        {
            "mark": {
                "type": "line"
            },
            "encoding": {
                "x": {
                    "field": "Week",
                    "type": "ordinal",
                    "title": "Weeks (September 2019 - February 2020)",
                    "sort": [
                        "1/9/2019",
                        "8/9/2019",
                        "15/9/2019",
                        "22/9/2019",
                        "29/9/2019",
                        "6/10/2019",
                        "13/10/2019",
                        "20/10/2019",
                        "27/10/2019",
                        "3/11/2019",
                        "10/11/2019",
                        "17/11/2019",
                        "24/11/2019",
                        "1/12/2019",
                        "8/12/2019",
                        "15/12/2019",
                        "22/12/2019",
                        "29/12/2019",
                        "5/1/2020",
                        "12/1/2020",
                        "19/1/2020",
                        "26/1/2020",
                        "2/2/2020",
                        "9/2/2020",
                        "16/2/2020",
                        "23/2/2020"
                    ],
                    "axis": {
                        "labelAngle": -40
                    }
                },
                "y": {
                    "field": "Value",
                    "type": "quantitative",
                    "title": "Rate change in no. of sales (%)",
                    "scale": {
                        "zero": true
                    }
                },
                "color": {
                    "field": "State",
                    "type": "nominal",
                    "title": "State"
                },
                "tooltip": [
                    {
                        "field": "State",
                        "type": "nominal",
                        "title": "State"
                    },
                    {
                        "field": "Value",
                        "type": "quantitative",
                        "title": "% change in sales"
                    },
                    {
                        "field": "Week",
                        "type": "nominal",
                        "title": "Week starting"
                    }
                ]
            }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "font": "Calibri",
            "fontWeight": 100,
            "fontSize": 12,
            "dx": -70,
            "dy": -100
          },
          "encoding": {
            "x": {
              "datum": "12/1/2020",
              "type": "ordinal"
            },
            "y": {
              "datum": 27.3,
              "type": "quantitative"
            },
            "text": {
              "value": "Peak in sales increase"
            }
          }
        },
        {
          "mark": {
            "type": "rule",
            "strokeDash": [1,3],
            "strokeWidth": 1
        },
          "encoding": {
            "x": {
              "datum": "5/1/2020",
              "type": "ordinal"
            },
            "y": {
              "value": 0
            }
          }
        }
    ],
    "config": {
        "legend": {
            "disable": true
        },
        "view": {
            "stroke": null
        }
    }
}