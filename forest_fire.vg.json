{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
      "text": "Percentage of Fire Area that is Forested by State (2019-2020)",
      "fontSize": 18
      },
    "width": 700,
    "height": 400,
    "projection": {"type": "mercator"},
    "data": {
      "url": "aus_state.topojson.json",
      "format": {"type": "topojson", "feature": "STE_2016_AUST"}
    },
    "transform": [
      {
        "lookup": "properties.STE_NAME16",
        "from": {
          "data": {
            "url": "forest_fire.csv",
            "format": {"type": "csv"}
          },
          "key": "State",
          "fields": ["perc_burnt"]
        }
      }
    ],
    "mark": {"type": "geoshape", "stroke": "white"},
    "encoding": {
      "color": {
        "field": "perc_burnt",
        "type": "quantitative",
        "scale": {
            "type": "linear",
            "range": ["#d9b38c", "#b58566", "#8c4f29", "#5e2a00"]
        },
        "legend": {
          "title": "Percentage (%)" 
        }
      },
      "tooltip": [
        {"field": "properties.STE_NAME16", "type": "nominal", "title": "State"},
        {"field": "perc_burnt", "type": "quantitative", "title": "Percentage of fire area that is forested (%)"}
      ]
    },
    "config": {
        "view": {
            "stroke": null
        },
        "legend": {
          "orient": "top-left"
        }
    }
  }